#!/bin/sh
# vpnctl — LiteOC VPN 控制 (需 root, 由菜单栏 App 经 sudo 免密调用)
# 用法: vpnctl {start|stop|status} <配置文件路径>
# 安全: 只用 grep+cut 解析配置 (不 source/不 eval); openconnect 二进制路径写死 (root 执行边界)
set -eu

cmd="${1:-status}"
CONF="${2:-}"

# 安全读取配置项 (KEY=VALUE, 取第一个 = 之后全部, 去引号)
cfg() {
    [ -n "$CONF" ] && [ -f "$CONF" ] || return 0
    grep -E "^$1=" "$CONF" 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^"//; s/"$//'
}

V_HOST="$(cfg HOST)"; V_USER="$(cfg USER)"; V_GROUP="$(cfg GROUP)"
V_CERT="$(cfg SERVERCERT)"; V_IPRE="$(cfg VPN_IP_PATTERN)"

# 必填校验 (SERVERCERT 可选, 留空则首次自动获取 — D9 TOFU)
miss=""
[ -n "$V_HOST" ]   || miss="$miss HOST"
[ -n "$V_USER" ]   || miss="$miss USER"
[ -n "$V_GROUP" ]  || miss="$miss GROUP"
[ -n "$miss" ] && { echo "config-error:缺$miss (检查配置文件)"; exit 3; }
[ -n "$V_IPRE" ] || V_IPRE="10\.[0-9]+\.[0-9]+\.[0-9]+|192\.168\.[0-9]+\.[0-9]+"  # 仅状态显示兜底

# openconnect 二进制: 写死的固定清单 (内置优先, brew 回退)
BIN=""
for p in /usr/local/libexec/liteoc/openconnect /opt/homebrew/bin/openconnect /usr/local/bin/openconnect; do
    [ -x "$p" ] && BIN="$p" && break
done
[ -n "$BIN" ] || { echo "openconnect-not-found (重新运行 LiteOC 安装器)"; exit 4; }

PIDFILE="/tmp/liteoc-openconnect.pid"
LOG="/tmp/liteoc-openconnect.log"

case "$cmd" in
  start)
    if pgrep -x openconnect >/dev/null 2>&1; then echo "already-running"; exit 0; fi
    PIN="$(cat)"   # PIN 从 stdin 读 (App 从钥匙串喂入)
    [ -n "$PIN" ] || { echo "no-pin"; exit 2; }
    # 证书指纹为空 → 自动探测: 不带 servercert 跑一次, openconnect 会报出 pin (认证前失败, 安全)
    DISCOVERED=""
    if [ -z "$V_CERT" ]; then
      V_CERT="$(echo | "$BIN" --user="$V_USER" --passwd-on-stdin "https://$V_HOST" 2>&1 \
                | grep -oE 'pin-sha256:[A-Za-z0-9+/=]+' | head -1 || true)"
      [ -n "$V_CERT" ] || { echo "cert-discover-failed"; exit 5; }
      DISCOVERED="$V_CERT"
    fi
    # stdin 顺序: 密码(第1行) + group(第2行); --background 后台驻留; 输出记日志供取 IP
    if printf '%s\n%s\n' "$PIN" "$V_GROUP" | "$BIN" --background --syslog --pid-file="$PIDFILE" \
         --user="$V_USER" --passwd-on-stdin --servercert="$V_CERT" \
         "https://$V_HOST" >"$LOG" 2>&1; then
      [ -n "$DISCOVERED" ] && echo "discovered-cert:$DISCOVERED"   # 让 App 回写到配置
      echo "started"
    else
      echo "auth-failed"; exit 1
    fi
    ;;
  stop)
    if pgrep -x openconnect >/dev/null 2>&1; then
      pkill -INT -x openconnect; echo "stopped"
    else
      echo "not-running"
    fi
    ;;
  status)
    if pgrep -x openconnect >/dev/null 2>&1; then
      # IP 优先取 openconnect 日志的 "Configured as <ip>"; 否则 ifconfig 按配置网段兜底
      ip="$(grep -oE 'Configured as [0-9.]+' "$LOG" 2>/dev/null | tail -1 | cut -d' ' -f3)"
      [ -n "$ip" ] || ip="$(ifconfig 2>/dev/null | grep -oE "inet ($V_IPRE)" | head -1 | cut -d' ' -f2)"
      echo "up ${ip:-unknown}"
    else
      echo "down"
    fi
    ;;
  *) echo "usage: vpnctl {start|stop|status} [config]" >&2; exit 64 ;;
esac
